import base64, requests
from datetime import datetime
from django.conf import settings as s

def _token():
    r = requests.get(f"{s.MPESA_BASE}/oauth/v1/generate?grant_type=client_credentials",
                     auth=(s.MPESA_KEY, s.MPESA_SECRET), timeout=20)
    return r.json()["access_token"]

def stk_push(phone, amount, ref):
    ts = datetime.now().strftime("%Y%m%d%H%M%S")
    pwd = base64.b64encode(f"{s.MPESA_SHORTCODE}{s.MPESA_PASSKEY}{ts}".encode()).decode()
    body = {"BusinessShortCode": s.MPESA_SHORTCODE, "Password": pwd, "Timestamp": ts,
        "TransactionType": "CustomerPayBillOnline", "Amount": int(amount), "PartyA": phone,
        "PartyB": s.MPESA_SHORTCODE, "PhoneNumber": phone, "CallBackURL": s.MPESA_CALLBACK_URL,
        "AccountReference": ref, "TransactionDesc": "Digital product"}
    r = requests.post(f"{s.MPESA_BASE}/mpesa/stkpush/v1/processrequest", json=body,
                      headers={"Authorization": f"Bearer {_token()}"}, timeout=20)
    return r.json()
